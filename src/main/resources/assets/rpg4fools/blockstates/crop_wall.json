{
  "multipart": [
    {
      "apply": {
        "model": "rpg4fools:block/crop_wall_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_side"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_side",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_side_alt"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "dead": "true"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead"
      }
    }
  ]
}
