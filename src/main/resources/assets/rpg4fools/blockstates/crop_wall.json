{
  "multipart": [
    {
      "when": {
        "OR": [
          {
            "north": "true"
          },
          {
            "east": "true"
          },
          {
            "south": "true"
          },
          {
            "west": "true"
          }
        ]
      },
      "apply": [
        {
          "model": "rpg4fools:block/crop_wall_post_a"
        },
        {
          "model": "rpg4fools:block/crop_wall_post_b"
        },
        {
          "model": "rpg4fools:block/crop_wall_post_c"
        }
      ]
    },
    {
      "when": {
        "north": "false",
        "east": "false",
        "south": "false",
        "west": "false"
      },
      "apply": [
        {
          "model": "rpg4fools:block/crop_wall_post_lone_a"
        },
        {
          "model": "rpg4fools:block/crop_wall_post_lone_b"
        },
        {
          "model": "rpg4fools:block/crop_wall_post_lone_c"
        }
      ]
    },
    {
      "when": {
        "north": "true"
      },
      "apply": [
        {
          "model": "rpg4fools:block/crop_wall_side_a"
        },
        {
          "model": "rpg4fools:block/crop_wall_side_b"
        },
        {
          "model": "rpg4fools:block/crop_wall_side_c"
        }
      ]
    },
    {
      "when": {
        "east": "true"
      },
      "apply": [
        {
          "model": "rpg4fools:block/crop_wall_side_a",
          "y": 90
        },
        {
          "model": "rpg4fools:block/crop_wall_side_b",
          "y": 90
        },
        {
          "model": "rpg4fools:block/crop_wall_side_c",
          "y": 90
        }
      ]
    },
    {
      "when": {
        "south": "true"
      },
      "apply": [
        {
          "model": "rpg4fools:block/crop_wall_side_alt_a"
        },
        {
          "model": "rpg4fools:block/crop_wall_side_alt_b"
        },
        {
          "model": "rpg4fools:block/crop_wall_side_alt_c"
        }
      ]
    },
    {
      "when": {
        "west": "true"
      },
      "apply": [
        {
          "model": "rpg4fools:block/crop_wall_side_alt_a",
          "y": 90
        },
        {
          "model": "rpg4fools:block/crop_wall_side_alt_b",
          "y": 90
        },
        {
          "model": "rpg4fools:block/crop_wall_side_alt_c",
          "y": 90
        }
      ]
    },
    {
      "when": {
        "dead": "true",
        "arm": "center",
        "row": "0"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_center_row0"
      }
    },
    {
      "when": {
        "dead": "true",
        "arm": "right",
        "row": "0"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_side_row0"
      }
    },
    {
      "when": {
        "dead": "true",
        "arm": "left",
        "row": "0"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_side_row0",
        "y": 180
      }
    },
    {
      "when": {
        "dead": "true",
        "arm": "center",
        "row": "1"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_center_row1"
      }
    },
    {
      "when": {
        "dead": "true",
        "arm": "right",
        "row": "1"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_side_row1"
      }
    },
    {
      "when": {
        "dead": "true",
        "arm": "left",
        "row": "1"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_side_row1",
        "y": 180
      }
    },
    {
      "when": {
        "dead": "true",
        "arm": "center",
        "row": "2"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_center_row2"
      }
    },
    {
      "when": {
        "dead": "true",
        "arm": "right",
        "row": "2"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_side_row2"
      }
    },
    {
      "when": {
        "dead": "true",
        "arm": "left",
        "row": "2"
      },
      "apply": {
        "model": "rpg4fools:block/crop_wall_dead_side_row2",
        "y": 180
      }
    }
  ]
}
