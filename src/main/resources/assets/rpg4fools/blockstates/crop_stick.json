{
  "multipart": [
    {
      "when": {
        "capped": "false"
      },
      "apply": {
        "model": "rpg4fools:block/crop_stick_post"
      }
    },
    {
      "when": {
        "capped": "true"
      },
      "apply": {
        "model": "rpg4fools:block/crop_stick_post_capped"
      }
    },
    {
      "when": {
        "dead": "true"
      },
      "apply": {
        "model": "rpg4fools:block/crop_stick_dead"
      }
    }
  ]
}
